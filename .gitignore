# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Env file 
.env

# Local config
config.toml

# The distilled router table, ~12MB, produced by project-black's distill.py and
# rewritten wholesale on every run — reproducible, so not committed. It MUST be
# present for the dense stage to work: without it /student.bin 404s and the router
# silently degrades to lexical-only (a console warning is the only signal).
#   uv run python src/router_train/distill.py     # in project-black
#   cp ../snappler/project-black/crates/pb-router/student.bin assets/
assets/student.bin
